# TerraMavuno root .env — one file serves both apps/globe (Vite envDir) and services/api (dotenv).
# Copy-Item .env.example .env   — then fill only the tiers you need. NEVER commit .env.
# Full step-by-step per key: docs/API_KEYS.md
#
# NOTE: the Supabase PERSONAL ACCESS TOKEN (sbp_...) is for local MCP auth ONLY.
# It must never be placed in this file, in .env, or in git. If exposed, rotate it.

# ============================================================================
# TIER 0 — REQUIRED FOR NOTHING (the app boots keyless: Esri imagery + bundled
# JSON data; the eligibility engine and result card work with ZERO keys)
# ============================================================================
VITE_API_URL=http://localhost:8787
# Port services/api listens on (default 8787). The globe's Vite dev proxy
# forwards /api there, so change both together if you change it.
PORT=8787
# Port the globe's Vite dev server binds (default 4173). Kept as a separate
# name so PORT above cannot accidentally collide with it.
GLOBE_PORT=4173

# ============================================================================
# TIER 1-3 — RECOMMENDED FOR THE DEMO
# ============================================================================

# Claude chat (server-only; without it chat is dead, map still works)
ANTHROPIC_API_KEY=

# Cinematic look — CLIENT-EXPOSED KEYS, visible in browser devtools by design.
# GOOGLE_MAPS_API_KEY: enable the Map Tiles API and RESTRICT the key by HTTP
# referrer (http://localhost:4173/*) + API restriction (Map Tiles API only).
GOOGLE_MAPS_API_KEY=
# VITE_CESIUM_ION_TOKEN: reaches the browser — use a token with assets:read
# scope ONLY and Allowed URLs restricted to your origins.
VITE_CESIUM_ION_TOKEN=
# Alias accepted by apps/globe/vite.config.js. Set EITHER this or the VITE_
# form above — the config reads whichever is present.
CESIUM_ION_TOKEN=

# ElevenLabs voice (all server-only; the browser only ever gets a signed URL)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=

# ============================================================================
# OPTIONAL — platform story and stretch goals
# ============================================================================

# Supabase (without these the API serves bundled JSON — demo still works)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-side project URL. Falls back to VITE_SUPABASE_URL if unset.
SUPABASE_URL=
# Service role. REQUIRED for farmer-channel persistence: a USSD caller has no auth.users row, so
# channel-owned conversations are invisible to every non-service role under RLS. Never prefix with
# VITE_ — that would ship a full-database key to the browser.
SUPABASE_SECRET_KEY=
# Server-side alias for the project URL. services/api reads SUPABASE_URL first
# and falls back to VITE_SUPABASE_URL, so setting either one works.
SUPABASE_URL=
DATABASE_URL=

# OPTIONAL: Cesium ion terrain/imagery. The demo uses OSM + ellipsoid without it.
VITE_CESIUM_ION_TOKEN=

# FARMER CHANNEL — USSD/SMS. This is the P0 return path, not an optional integration.
#
# FIELD_REPORT_SALT   Salt for hashing caller identities. REQUIRED anywhere real: without it the
#                     code falls back to a public development default, and an unsalted sha256 of a
#                     Kenyan MSISDN is brute-forceable in seconds (only ~10^8 valid numbers).
#                     Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CHANNEL_WEBHOOK_TOKEN
#                     Unguessable path segment for the AT callbacks. Africa's Talking does not sign
#                     its webhooks, so this plus an IP allowlist is the only authentication there
#                     is. Webhooks return 503 until it is set. Generate the same way as the salt.
# PUBLIC_API_BASE_URL Public HTTPS base URL of this API. Used only to print the exact callback URLs
#                     to paste into the AT dashboard (npm run channels:urls).
FIELD_REPORT_SALT=
CHANNEL_WEBHOOK_TOKEN=
PUBLIC_API_BASE_URL=

# Africa's Talking. AFRICASTALKING_ENV selects the host: sandbox uses api.sandbox.africastalking.com
# and the literal username "sandbox"; production uses api.africastalking.com and your account
# username. If ENV is blank it is inferred from the username.
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_ENV=sandbox
# Sender ID / alphanumeric shortcode for outbound SMS. Blank is fine on sandbox.
AFRICASTALKING_SHORTCODE=
# The USSD service code AT assigns you, e.g. *384*12345#. Informational: the callback is matched
# by URL, not by this value.
AFRICASTALKING_USSD_SERVICE_CODE=

# OPTIONAL: voice and the later-phase channel adapters
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# WhatsApp share, stretch (server-only; Share button hidden without them)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_VERIFY_TOKEN=

# USSD/SMS simulator, stretch (server-only)
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SHORTCODE=

# Legacy optional evidence providers (not used in the P0 demo path)
OPENWEATHER_API_KEY=
NASA_EARTHDATA_TOKEN=
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
MAPBOX_ACCESS_TOKEN=
GROQ_API_KEY=
OPENAI_API_KEY=
